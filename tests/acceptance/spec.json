[
  {
    "id": "selection-floating-dock-provider",
    "intent": "Selected text opens a floating chat, keeps provider controls stable, and preserves provider when docked",
    "runner": "cft",
    "settings": {
      "selectionToolbarOpenMode": "floating",
      "lastSelectedProvider": "chatgpt",
      "rememberLastProvider": true,
      "enabledProviders": ["chatgpt", "claude", "gemini", "google", "grok", "deepseek"]
    },
    "steps": [
      { "action": "openPage", "fixture": "article-page.html" },
      { "action": "selectText", "target": "mainParagraph" },
      { "assert": "selectionToolbarVisible", "openMode": "floating" },
      { "action": "clickToolbarAction", "name": "Send" },
      { "assert": "floatingVisible" },
      {
        "assert": "floatingTopControls",
        "equals": [
          "floating-open-chat-history",
          "floating-open-prompt-library",
          "floating-dock",
          "floating-options",
          "floating-close"
        ]
      },
      {
        "assert": "floatingProviderTabs",
        "activeProvider": "chatgpt",
        "iconOnly": true,
        "position": "bottom",
        "providerTitles": ["ChatGPT", "Claude", "Gemini", "Google", "Grok", "DeepSeek"]
      },
      { "assert": "embeddedProviderHeaderHidden", "provider": "chatgpt" },
      { "action": "switchFloatingProvider", "provider": "claude" },
      { "assert": "floatingProvider", "provider": "claude" },
      { "assert": "storageProvider", "provider": "claude" },
      { "action": "dockFloating" },
      { "assert": "storageProvider", "provider": "claude" },
      { "assert": "sidebarProvider", "provider": "claude" },
      { "assert": "sidebarProviderTabsOnly", "providers": ["chatgpt", "claude", "gemini", "google", "grok", "deepseek"] }
    ]
  },
  {
    "id": "selection-ask-autosubmit",
    "intent": "Ask action opens question panel and sends question to floating provider with auto-submit enabled",
    "runner": "cft",
    "settings": {
      "selectionToolbarOpenMode": "floating",
      "lastSelectedProvider": "chatgpt",
      "rememberLastProvider": true,
      "enabledProviders": ["chatgpt", "claude", "gemini", "google", "grok", "deepseek"]
    },
    "steps": [
      { "action": "openPage", "fixture": "article-page.html" },
      { "action": "selectText", "target": "mainParagraph" },
      { "assert": "selectionToolbarVisible", "openMode": "floating" },
      { "action": "clickToolbarAction", "name": "Ask", "waitForFloating": false },
      { "assert": "askPanelVisible", "quoteIncludes": "Industry produced over 90 percent of notable frontier AI models" },
      { "action": "submitAskQuestion", "question": "What is the main point of this paragraph?" },
      { "assert": "floatingVisible" },
      { "assert": "floatingReferenceQuestion", "includes": "What is the main point of this paragraph?" },
      { "assert": "floatingAutoSubmit", "value": true, "minPromptLength": 150 },
      {
        "assert": "providerReceivedPrompt",
        "provider": "chatgpt",
        "includes": "What is the main point of this paragraph?",
        "autoSubmit": true,
        "submitted": true,
        "minPromptLength": 150
      },
      { "assert": "storageProvider", "provider": "chatgpt" },
      { "action": "dockFloating" },
      { "assert": "sidebarProvider", "provider": "chatgpt" },
      { "assert": "sidebarProviderUrl", "includes": "conversation=submitted-1" },
      { "action": "selectText", "target": "secondaryParagraph" },
      { "assert": "selectionToolbarVisible", "openMode": "floating" },
      { "action": "clickToolbarAction", "name": "Send", "waitForFloating": false },
      {
        "assert": "sidebarProviderReceivedPrompt",
        "provider": "chatgpt",
        "includes": "controlled page is intentionally simple",
        "excludes": "Source: http://127.0.0.1",
        "autoSubmit": false,
        "submitted": false,
        "minPromptLength": 80
      },
      { "assert": "sidebarProviderUrl", "includes": "conversation=submitted-1" },
      { "assert": "floatingHidden" }
    ]
  },
  {
